{
  "userAgent": "job_seeker_ro_spider",
  "requestTimeoutSec": 10,
  "pageDelaySec": 1.0,
  "retry": {
    "maxAttempts": 5,
    "baseDelaySec": 2.0,
    "maxDelaySec": 60.0,
    "retryStatus": [
      429,
      500,
      502,
      503,
      504
    ]
  },
  "rendering": {
    "mode": "static",
    "waitSelector": "",
    "timeoutMs": 30000
  },
  "staleJobDeletion": false,
  "manageCompany": true,
  "defaultLocation": [
    "România"
  ],
  "defaultWorkmode": null,
  "ownJobUrlPrefix": "https://apply.workable.com/",
  "sources": {
    "sitemap": "",
    "listing": "https://apply.workable.com/api/v1/widget/accounts/greenvolt?details=true",
    "jobArchive": "https://apply.workable.com/greenvolt/"
  },
  "selectors": {
    "jobArticle": [
      "",
      "[class*='job']",
      ".vacancy, .position, .listing-item"
    ],
    "jobTitle": [
      "",
      "h1, h2, h3, h4",
      "[itemprop='title'], [aria-label]",
      "a"
    ],
    "jobMeta": [
      "",
      "p, .meta, [class*='deadline']"
    ]
  }
}
